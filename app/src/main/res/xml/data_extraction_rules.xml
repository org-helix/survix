<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: surveys move with the phone on a device-to-device transfer and its backup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="surveys/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="surveys/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
